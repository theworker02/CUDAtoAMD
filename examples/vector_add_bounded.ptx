// A bounds-safe vector addition: extra launch threads branch to DONE.
.version 7.0
.target sm_50
.address_size 64
.visible .entry ptx_vector_add_bounded(.param .u64 a, .param .u64 b, .param .u64 c, .param .u32 n) {
  .reg .pred %p<1>;
  .reg .u32 %r<5>;
  .reg .u64 %d<7>;
  .reg .f32 %f<3>;
  ld.param.u64 %d0, [a];
  ld.param.u64 %d1, [b];
  ld.param.u64 %d2, [c];
  ld.param.u32 %r4, [n];
  mov.u32 %r0, %ctaid.x;
  mov.u32 %r1, %ntid.x;
  mul.lo.u32 %r2, %r0, %r1;
  mov.u32 %r3, %tid.x;
  add.u32 %r2, %r2, %r3;
  setp.lt.u32 %p0, %r2, %r4;
  @%p0 bra ACTIVE;
  bra DONE;
  ACTIVE:;
  cvt.u64.u32 %d3, %r2;
  mul.lo.u64 %d3, %d3, 4;
  add.u64 %d4, %d0, %d3;
  add.u64 %d5, %d1, %d3;
  add.u64 %d6, %d2, %d3;
  ld.global.f32 %f0, [%d4];
  ld.global.f32 %f1, [%d5];
  add.rn.f32 %f2, %f0, %f1;
  st.global.f32 [%d6], %f2;
  DONE:;
  ret;
}
