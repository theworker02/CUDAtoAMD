.version 7.0
.target sm_50
.address_size 64
.visible .entry ptx_affine_u32(.param .u64 source, .param .u64 destination, .param .u32 count) {
  .reg .pred %p<1>;
  .reg .u32 %r<6>;
  .reg .u64 %d<5>;
  ld.param.u64 %d0, [source];
  ld.param.u64 %d1, [destination];
  ld.param.u32 %r4, [count];
  mov.u32 %r0, %ctaid.x;
  mul.lo.u32 %r0, %r0, %ntid.x;
  add.u32 %r0, %r0, %tid.x;
  setp.ge.u32 %p0, %r0, %r4;
  @%p0 bra DONE;
  cvt.u64.u32 %d2, %r0;
  mul.wide.u32 %d3, %r0, 4;
  add.u64 %d2, %d0, %d3;
  add.u64 %d4, %d1, %d3;
  ld.global.u32 %r1, [%d2];
  mul.lo.u32 %r2, %r1, 3;
  add.u32 %r3, %r2, 7;
  st.global.u32 [%d4], %r3;
  DONE:;
  ret;
}
